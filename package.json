{
  "name": "tricentis-demo-web-shop-playwright",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md,mjs}\"",
    "prepare": "husky",
    "test": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\" --workers=2",
    "test:sanity": "playwright test --grep \"@sanity\" --workers=2",
    "test:tier1": "playwright test tests/catalog tests/quality --workers=2",
    "test:tier2": "playwright test tests/auth --workers=2",
    "test:tier3": "playwright test tests/catalog --workers=2",
    "test:tier4": "playwright test tests/account --workers=2",
    "test:tier5": "playwright test tests/cart --workers=2",
    "test:tier6": "playwright test tests/checkout --workers=2",
    "test:tier7": "playwright test tests/account --workers=2",
    "test:all": "playwright test --workers=2",
    "test:regression": "playwright test --workers=2",
    "report:issues": "node scripts/create-playwright-issues.mjs",
    "report:summary": "node scripts/summarize-playwright-results.mjs",
    "test:auth": "playwright test tests/auth",
    "test:catalog": "playwright test tests/catalog",
    "test:cart": "playwright test tests/cart",
    "test:checkout": "playwright test tests/checkout",
    "test:account": "playwright test tests/account",
    "test:quality": "playwright test tests/quality"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.12.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript-eslint": "^8.0.0"
  }
}
